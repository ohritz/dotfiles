{{- $choices := list "wsl2" "linux" "windows" "msys2" -}}
{{- $env := promptChoice "Select your environment (wsl2, linux, windows, msys2)" $choices -}}
{{- $stenaprojectsdirval := promptStringOnce . "stenaprojectsdir" "Where are the stena projects" "" -}}
{{- $winhomedirval := promptStringOnce . "winhome" "Path to the windows home dir eg. /mnt/c/Users/sofe" "/mnt/c/Users/sofe" -}}
{{- $winusernameval := promptStringOnce . "winusername" "Whats the the windows username" "" -}}

{{- $iswsl := eq $env "wsl2" -}}
{{- $islinux := eq $env "linux" -}}
{{- $iswindows := eq $env "windows" -}}
{{- $ismsys2 := eq $env "msys2" -}}

[data]
    iswsl = {{ $iswsl }}
    islinux = {{ $islinux }}
    iswindows = {{ $iswindows }}
    ismsys2 = {{ $ismsys2 }}
    stenaprojectsdir = {{ $stenaprojectsdirval | quote }}
    winhome = {{ $winhomedirval | quote }}
    winusername = {{ $winusernameval | quote }}

[diff]
    command = "code"
    args = ["--wait", "--diff"]
    exclude = ["scripts"]

[git]
{{- if $ismsys2 }}
    command = "/mingw64/bin/git"
{{- end }}
{{- if $iswindows }}
    command = "C:/msys64/usr/bin/git.exe"
{{- else }}
    command = "/usr/bin/git"
{{- end -}}


{{ if $ismsys2 }}
[keeper]
    command = "C:/Program Files (x86)/Keeper Commander/keeper-commander.exe"
[interpreters.sh]
    command = "C:/msys64/usr/bin/zsh.exe"
{{- end -}}

{{ if or $iswsl $islinux }}
[keeper]
    command = "/home/sohan/.local/bin/keeper"
{{- end -}}

{{ if $iswindows }}
[keeper]
    command = "C:/Program Files (x86)/Keeper Commander/keeper-commander.exe"
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo"]
{{- end -}}
