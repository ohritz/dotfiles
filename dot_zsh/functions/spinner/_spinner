# Shows a spinner while another command is running. Randomly picks one of 12 spinner styles.
# @args command to run (with any parameters) while showing a spinner.
#       E.g. ‹spinner sleep 10›

function _spinner() {
  trap "tput cnorm" EXIT

  local pid=$1 # Process Id of the previous running command

  local spinner_type=${SPINNER_TYPE:-2}

  # Use arrays instead of strings - much better for Unicode!
  local -a spin_chars
  case $spinner_type in
  0)
    spin_chars=('⠁' '⠂' '⠄' '⡀' '⢀' '⠠' '⠐' '⠈')
    ;;
  1)
    spin_chars=('-' '\' '|' '/')
    ;;
  2)
    spin_chars=('▁' '▂' '▃' '▄' '▅' '▆' '▇' '█' '▇' '▆' '▅' '▄' '▃' '▂' '▁')
    ;;
  3)
    spin_chars=('▉' '▊' '▋' '▌' '▍' '▎' '▏' '▎' '▍' '▌' '▋' '▊' '▉')
    ;;
  4)
    spin_chars=('←' '↖' '↑' '↗' '→' '↘' '↓' '↙')
    ;;
  5)
    spin_chars=('▖' '▘' '▝' '▗')
    ;;
  6)
    spin_chars=('┤' '┘' '┴' '└' '├' '┌' '┬' '┐')
    ;;
  7)
    spin_chars=('◢' '◣' '◤' '◥')
    ;;
  8)
    spin_chars=('◰' '◳' '◲' '◱')
    ;;
  9)
    spin_chars=('◴' '◷' '◶' '◵')
    ;;
  10)
    spin_chars=('◐' '◓' '◑' '◒')
    ;;
  11)
    spin_chars=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷')
    ;;
  esac

  local i=1  # zsh arrays are 1-indexed
  local total=${#spin_chars}

  tput civis # cursor invisible
  while kill -0 $pid 2>/dev/null; do
    printf "\r%s " "${spin_chars[$i]}"

    # Increment with wraparound (zsh-style)
    i=$(( i % total + 1 ))
    sleep .1
  done
  printf "\r \r"  # Clear the spinner
  tput cnorm
  wait $pid # capture exit code
  return $?
}
